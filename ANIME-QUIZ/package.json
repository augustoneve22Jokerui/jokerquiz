{
  "name": "anime-quiz-ecosystem",
  "version": "1.0.0",
  "description": "Plataforma competitiva e ecossistema de Anime Gaming em tempo real com torneios, rankings e multiplayer.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:check": "node scripts/check-db.js"
  },
  "keywords": [
    "anime",
    "quiz",
    "gaming",
    "esports",
    "socketio",
    "realtime",
    "competitivo",
    "tournaments",
    "angola"
  ],
  "author": "Anime Quiz Engineering Team",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0"
  }
}